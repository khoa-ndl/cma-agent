# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Model used by the CMA agent
ANTHROPIC_MODEL=claude-sonnet-5-5

# Postgres connection string (Neon in the sandbox; any Postgres host works)
DATABASE_URL=

# Random secret for signing session cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Password for the /admin dashboard (operator only)
ADMIN_PASSWORD=
