# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Model used by the CMA agent
ANTHROPIC_MODEL=claude-sonnet-5-5

# Postgres connection string (Neon in the sandbox; any Postgres host works)
DATABASE_URL=

# Random secret for signing session cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Password for the /admin dashboard (operator only)
ADMIN_PASSWORD=

# Sentry error tracking (optional -- the app runs fine with these unset,
# Sentry.init() just no-ops). From the Vercel Marketplace Sentry
# integration, or your own Sentry project's Settings > Client Keys (DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Only needed for readable (non-minified) stack traces in Sentry's UI.
SENTRY_AUTH_TOKEN=
