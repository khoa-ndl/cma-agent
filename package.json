{
  "name": "cma-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "drizzle-kit migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run typecheck && npm run lint && vitest run",
    "test:live": "LIVE=1 node --env-file=.env node_modules/vitest/vitest.mjs run",
    "data:generate": "tsx scripts/generate-data.ts",
    "db:seed": "node --env-file=.env node_modules/.bin/tsx scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "codes:issue": "node --env-file=.env node_modules/.bin/tsx scripts/issue-code.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "unpdf": "^1.8.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
